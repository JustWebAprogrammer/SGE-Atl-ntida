// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoUsuario {
  admin
  estudante
  orientador
  recepcionista
  gestor
}

enum EstadoEstudante {
  EmCurso
  Finalizado
  Desistente
}

enum EstadoMonografia {
  Submetida
  EmRevisao
  Aprovada
  ParaDefender
  Defendida
  Rejeitada
}

enum EstadoPremonografia {
  Proposto
  Aprovado
  Reprovado
  Cancelado
}

enum EstadoSolicitacao {
  Pendente
  Aceite
  Recusado
  Cancelado
}

enum EstadoFactura {
  Pendente
  Pago
  Atrasado
}

enum EstadoNotaCobranca {
  Pendente
  Pago
  Negociado
}

enum FormaPagemento {
  Multicaixa
  Transferencia
  Dinheiro
}

enum TipoCertificado {
  Conclusao
  Disciplina
  Participacao
}

enum TurnoRecepcionista {
  Manha
  Tarde
  Noite
}

enum Semestre {
  S1
  S2
}

model Usuario {
  id_usuario    Int         @id @default(autoincrement())
  nome_usuario  String      @unique @db.VarChar(50)
  email         String      @unique @db.VarChar(100)
  senha         String      @db.VarChar(255)
  tipo_usuario  TipoUsuario
  data_cadastro DateTime    @default(now())

  admin         Admin?
  estudante     Estudante?
  orientador    Orientador?
  recepcionista Recepcionista?
  auditLogs     AuditLog[]
}

model Admin {
  id_admin         Int     @id @default(autoincrement())
  nome_completo    String? @db.VarChar(80)
  numero_telemovel String? @unique @db.VarChar(15)
  id_usuario       Int     @unique
  usuario          Usuario @relation(fields: [id_usuario], references: [id_usuario])
}

model Departamento {
  id_departamento   Int                                   @id @default(autoincrement())
  nome_departamento String                                @db.VarChar(100)
  descricao         String?                               @db.Text
  disciplinas       Disciplina[]
  cursos            Curso[]
  estatisticas      EstatisticasMonografiasDepartamento[]
}

model Curso {
  id_curso        Int             @id @default(autoincrement())
  nome_curso      String          @db.VarChar(100)
  duracao_anos    Int?
  id_departamento Int             @default(1)
  departamento    Departamento    @relation(fields: [id_departamento], references: [id_departamento])
  estudantes      Estudante[]
  precos          Precos[]
  precos_propina  PrecosPropina[]
}

model Disciplina {
  id_disciplina           Int                      @id @default(autoincrement())
  nome_disciplina         String                   @db.VarChar(100)
  codigo_disciplina       String                   @unique @db.VarChar(10)
  creditos                Int
  id_departamento         Int
  departamento            Departamento             @relation(fields: [id_departamento], references: [id_departamento])
  notas                   Nota[]
  certificado_disciplinas CertificadoDisciplinas[]
}

model Estudante {
  id_estudante       Int                     @id @default(autoincrement())
  nome_completo      String                  @db.VarChar(80)
  numero_telemovel   String?                 @unique @db.VarChar(15)
  id_curso           Int
  id_usuario         Int                     @unique
  ano_current        Int?
  ano_electivo       String?                 @db.VarChar(9)
  estado             EstadoEstudante         @default(EmCurso)
  pagamento          String                  @default("Pendente")
  data_cadastro      DateTime?               @db.Date
  curso              Curso                   @relation(fields: [id_curso], references: [id_curso])
  usuario            Usuario                 @relation(fields: [id_usuario], references: [id_usuario])
  notas              Nota[]
  monografias        Monografia[]
  premonografias     Premonografia[]
  solicitacoes       SolicitacaoOrientacao[]
  facturas           Factura[]
  pagamentos_propina PagamentoPropina[]
  notas_cobranca     NotaCobranca[]
  certificados       Certificado[]
  curriculos         CurriculoAcademico[]
}

model Orientador {
  id_orientador        Int                       @id @default(autoincrement())
  nome_completo        String                    @db.VarChar(80)
  especialidade        String                    @db.VarChar(100)
  numero_telemovel     String?                   @db.VarChar(15)
  id_usuario           Int                       @unique
  usuario              Usuario                   @relation(fields: [id_usuario], references: [id_usuario])
  monografias_correcao MonografiasParaCorrecao[]
  solicitacoes         SolicitacaoOrientacao[]
}

model Recepcionista {
  id_recepcionista Int                @id @default(autoincrement())
  nome_completo    String             @db.VarChar(80)
  turno            TurnoRecepcionista @default(Manha)
  id_usuario       Int                @unique
  usuario          Usuario            @relation(fields: [id_usuario], references: [id_usuario])
}

model Nota {
  id_nota       Int        @id @default(autoincrement())
  id_estudante  Int
  id_disciplina Int
  valor_nota    Decimal    @db.Decimal(4, 2)
  ano_lectivo   String     @db.VarChar(9)
  semestre      Semestre   @default(S1)
  estudante     Estudante  @relation(fields: [id_estudante], references: [id_estudante])
  disciplina    Disciplina @relation(fields: [id_disciplina], references: [id_disciplina])
}

model Monografia {
  id_monografia        Int                       @id @default(autoincrement())
  id_estudante         Int
  titulo               String                    @db.VarChar(200)
  resumo               String?                   @db.Text
  descricao            String?                   @db.Text
  caminho_arquivo      String?
  nome_arquivo         String?
  data_submissao       DateTime                  @db.Date
  data_envio_gestor    DateTime?
  data_correcao_gestor DateTime?
  data_defesa          DateTime?                 @db.Date
  estado               EstadoMonografia          @default(Submetida)
  nota_final           Decimal?                  @db.Decimal(4, 2)
  nota_gestor          Decimal?                  @db.Decimal(4, 2)
  feedback             String?                   @db.Text
  feedback_gestor      String?                   @db.Text
  estudante            Estudante                 @relation(fields: [id_estudante], references: [id_estudante])
  correcoes            MonografiasParaCorrecao[]
}

model MonografiasParaCorrecao {
  id_monografia_correcao Int        @id @default(autoincrement())
  id_monografia          Int
  id_orientador          Int
  data_correcao          DateTime?  @db.Date
  observacoes            String?    @db.Text
  monografia             Monografia @relation(fields: [id_monografia], references: [id_monografia])
  orientador             Orientador @relation(fields: [id_orientador], references: [id_orientador])
}

model Premonografia {
  id_premonografia Int                 @id @default(autoincrement())
  id_estudante     Int
  tema             String              @db.VarChar(200)
  data_proposta    DateTime            @db.Date
  estado           EstadoPremonografia @default(Proposto)
  estudante        Estudante           @relation(fields: [id_estudante], references: [id_estudante])
}

model SolicitacaoOrientacao {
  id_solicitacao   Int               @id @default(autoincrement())
  id_estudante     Int
  id_orientador    Int
  data_solicitacao DateTime          @db.Date
  estado           EstadoSolicitacao @default(Pendente)
  observacoes      String?           @db.Text
  estudante        Estudante         @relation(fields: [id_estudante], references: [id_estudante])
  orientador       Orientador        @relation(fields: [id_orientador], references: [id_orientador])
}

model Factura {
  id_factura        Int           @id @default(autoincrement())
  id_estudante      Int
  numero_factura    String?       @unique @db.VarChar(20)
  descricao_servico String?       @db.VarChar(100)
  valor_total       Decimal       @default(0.00) @db.Decimal(10, 2)
  valor_final       Decimal?      @db.Decimal(10, 2)
  data_emissao      DateTime      @db.Date
  data_vencimento   DateTime      @db.Date
  estado            EstadoFactura @default(Pendente)
  periodo           String?
  ano_lectivo       String?       @db.VarChar(9)
  metodo_pagamento  String?
  data_pagamento    DateTime?
  id_recepcionista  Int?
  estudante         Estudante     @relation(fields: [id_estudante], references: [id_estudante])
}

model PagamentoPropina {
  id_pagamento    Int            @id @default(autoincrement())
  id_estudante    Int
  valor_pago      Decimal        @db.Decimal(10, 2)
  data_pagamento  DateTime       @db.Date
  forma_pagamento FormaPagemento @default(Multicaixa)
  recibo_numero   String?        @unique @db.VarChar(20)
  estudante       Estudante      @relation(fields: [id_estudante], references: [id_estudante])
}

model NotaCobranca {
  id_nota_cobranca Int                @id @default(autoincrement())
  id_estudante     Int
  descricao        String             @db.Text
  valor            Decimal            @db.Decimal(10, 2)
  data_vencimento  DateTime           @db.Date
  estado           EstadoNotaCobranca @default(Pendente)
  estudante        Estudante          @relation(fields: [id_estudante], references: [id_estudante])
}

model Precos {
  id_preco        Int      @id @default(autoincrement())
  id_curso        Int
  valor_anual     Decimal  @db.Decimal(10, 2)
  valor_semestral Decimal? @db.Decimal(10, 2)
  data_validade   DateTime @db.Date
  curso           Curso    @relation(fields: [id_curso], references: [id_curso])
}

model PrecosPropina {
  id_preco_propina Int     @id @default(autoincrement())
  descricao        String  @db.VarChar(100)
  valor            Decimal @db.Decimal(10, 2)
  ano_lectivo      String  @db.VarChar(9)
  id_curso         Int?
  curso            Curso?  @relation(fields: [id_curso], references: [id_curso])
}

model Certificado {
  id_certificado   Int                      @id @default(autoincrement())
  id_estudante     Int
  data_emissao     DateTime                 @db.Date
  tipo_certificado TipoCertificado
  descricao        String?                  @db.Text
  estudante        Estudante                @relation(fields: [id_estudante], references: [id_estudante])
  disciplinas      CertificadoDisciplinas[]
}

model CertificadoDisciplinas {
  id_certificado_disciplina Int         @id @default(autoincrement())
  id_certificado            Int
  id_disciplina             Int
  certificado               Certificado @relation(fields: [id_certificado], references: [id_certificado])
  disciplina                Disciplina  @relation(fields: [id_disciplina], references: [id_disciplina])
}

model CurriculoAcademico {
  id_curriculo Int       @id @default(autoincrement())
  id_estudante Int
  ano_lectivo  String    @db.VarChar(9)
  descricao    String?   @db.Text
  estudante    Estudante @relation(fields: [id_estudante], references: [id_estudante])
}

model EstatisticasMonografiasDepartamento {
  id_estatistica         Int          @id @default(autoincrement())
  id_departamento        Int
  total_monografias      Int          @default(0)
  monografias_aprovadas  Int          @default(0)
  monografias_reprovadas Int          @default(0)
  data_atualizacao       DateTime     @default(now())
  departamento           Departamento @relation(fields: [id_departamento], references: [id_departamento])
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  id_usuario   Int
  acao         String   @db.VarChar(100)
  tabela       String   @db.VarChar(50)
  id_registro  Int
  valor_antes  String?  @db.Text
  valor_depois String?  @db.Text
  ip_address   String   @db.VarChar(45)
  data_hora    DateTime @default(now())
  usuario      Usuario  @relation(fields: [id_usuario], references: [id_usuario])
}
